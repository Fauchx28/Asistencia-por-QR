# Copia este archivo como .env y ajusta los valores.

# Servidor
PORT=3000
APP_TIMEZONE=America/Bogota
# Ruta del archivo de base de datos (se crea solo)
DB_PATH=./data/asistencia.db
# Pon true si la app está detrás de un proxy con HTTPS (Nginx, Render, Railway…)
TRUST_PROXY=false
# Pon true en producción con HTTPS para que la cookie de sesión solo viaje cifrada
COOKIE_SECURE=false
# Dirección pública de la app (necesaria para los enlaces de "Olvidé mi contraseña")
APP_URL=http://localhost:3000

# Registro de docentes
# false = nadie más puede crear cuentas (crea primero la tuya)
ALLOW_REGISTRATION=true
# Si lo defines, quien se registre por primera vez debe escribir este código (compártelo solo con tus docentes)
REGISTRATION_CODE=

# Nombre y contacto de quien administra la plataforma (aparecen en la política de datos y en la autorización de acudientes)
ORG_NAME=
PRIVACY_CONTACT=

# Correos de los administradores (pueden descargar las copias de seguridad desde Mi cuenta), separados por coma
ADMIN_EMAILS=

# Copias de seguridad automáticas de la base de datos
BACKUP_ENABLED=true
# Carpeta de las copias (por defecto data/backups, junto a la base de datos)
BACKUP_DIR=
# Hora diaria de la copia (24 h, hora del colegio) y cuántas copias conservar
BACKUP_TIME=02:00
BACKUP_KEEP=14

# Reporte semanal automático
REPORT_AUTO_SEND=true
# Día: 0=domingo, 1=lunes … 5=viernes, 6=sábado
REPORT_DAY=5
# Hora local (24 h)
REPORT_TIME=16:00

# Correo (SMTP). Déjalo vacío hasta configurarlo; sin esto no se envían reportes ni enlaces de recuperación.
# Ejemplo con Gmail (crea una "contraseña de aplicación" en tu cuenta de Google):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu-correo@gmail.com  SMTP_PASS=contraseña-de-aplicacion
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Idioma para leer fotos (Tesseract) y carpeta donde se guarda después de descargarlo
OCR_LANG=spa
OCR_CACHE_DIR=
