# Copia este archivo como .env y ajusta los valores.

# Servidor
PORT=3000
APP_TIMEZONE=America/Bogota
# Ruta del archivo de base de datos (se crea solo)
DB_PATH=./data/asistencia.db
# Pon true si la app está detrás de un proxy con HTTPS (Nginx, Render, Railway…)
TRUST_PROXY=false
# Pon true en producción con HTTPS para que la cookie de sesión solo viaje cifrada
COOKIE_SECURE=false
# false = nadie más puede crear cuentas (crea primero la tuya)
ALLOW_REGISTRATION=true

# Reporte semanal automático
REPORT_AUTO_SEND=true
# Día: 0=domingo, 1=lunes … 5=viernes, 6=sábado
REPORT_DAY=5
# Hora local (24 h)
REPORT_TIME=16:00

# Correo (SMTP). Ejemplo con Gmail: crea una "contraseña de aplicación" en tu cuenta de Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion
MAIL_FROM="Asistencia QR <tu-correo@gmail.com>"

# Idioma para leer fotos (Tesseract)
OCR_LANG=spa
